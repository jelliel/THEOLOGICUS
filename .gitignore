# Cle de signature — JAMAIS suivie (fuite = usurpation d'identite du createur)
*.pfx
THEOLOGICUS_signing.pfx

# Dossiers de build deplaces (renommes en *.oldrun pour contourner le garde-fou
# de suppression) — ne JAMAIS les committer : ils DUPLIQUENT dist/ (des centaines
# de Mo). Un `git add dist` les embarquait par accident.
*.oldrun/
*.oldrun.exe

# Logs des serveurs locaux (proxy_server.py : FreeLLMAPI, LibreTranslate,
# Supertonic…) — artifacts d'execution, jamais suivis.
logs/

# Jar de cookies de session (fuite = usurpation de session) — jamais suivi.
theologicus_cookiejar.json

# serveur de test temporaire du banc d'assemblage (v458)
_montage_test_serveur.py

# v588 — dossier des EXPORTS de l'app (proxy_server.py /save-data). La WebView
# ne télécharge pas les blob URL : c'est ici que les exports d'agents/données
# atterrissent réellement. Fichiers de l'utilisateur, jamais suivis.
backups/

# Scripts de diagnostic jetables (dbg_*.js) : ils servent a MESURER une panne
# dans un navigateur, puis n'ont plus aucune valeur. Les laisser non suivis
# encombrait `git status` a chaque fois et masquait les vrais fichiers modifies.
dbg_*.js

# Dependances du banc Playwright (installees par tools/run_benches.py)
node_modules/
package-lock.json

# Donnees reelles extraites du store utilisateur (vie privee) — JAMAIS suivies
.workbuddy-ai/artifacts/**/real_chat.json
.workbuddy-ai/artifacts/**/neg_root/

