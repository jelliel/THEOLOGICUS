# APK residuels de .workbuddy-ai/artifacts/ : 23 fichiers, 428 Mo, non suivis.
# AUCUN motif ne les couvrait : ils n'etaient hors git que parce que personne
# ne les avait `git add`. Un `git add -A` les faisait entrer (mesure : le
# 2026-09-22). Les livrables viennent des Releases GitHub, pas d'ici.
*.apk
*.aab

# Secrets a la racine du depot : meme piege que les APK, mais l'enjeu n'est pas
# le poids. `THEOLOGICUS_signing.pfx` est la cle de signature des Releases : si
# elle entre dans l'historique, n'importe qui peut publier un APK que nos
# utilisateurs installeraient. Un fichier nomme "mistral api key.txt" y dormait
# aussi. Aucun motif ne les couvrait (verifie le 2026-09-22) : seul `git add -A`
# les separait du depot public.
*.pfx
*.p12
*.jks
*.keystore
*.pem
*.key
*api key*.txt
*mistral*key*
*secret*
*credential*

# Caches HTTP des generateurs de corpus (jamais versionner)
tools/.summa_cache/
tools/.fathers_cache/

tools/.ccel_cache/
tools/.orthodox_cache/
tools/.islamic_cache/
tools/.denzinger_cache/
tools/.summafr_cache/

# Extraits video/audio des diagnostics TTS (v106) : captures de travail, pas des
# livrables. Les .wav pesent plusieurs Mo et les .jpg sont des images extraites
# d'une video locale — aucun interet dans l'historique public.
.workbuddy-ai/artifacts/_tts/*.wav
.workbuddy-ai/artifacts/_tts/*.jpg
.workbuddy-ai/artifacts/_tts/*.mp4

# Cache audio du service Supertonic (residu local, pas un livrable)
tools/.supertonic_cache/

# Residus d'execution des bancs : profils Chrome jetables, journal du service,
# images extraites des videos. Rien de tout cela n'est un livrable.
.workbuddy-ai/artifacts/_tts/profil-*/
.workbuddy-ai/artifacts/_tts/supertonic-service.log
.workbuddy-ai/artifacts/_tts/frames/
